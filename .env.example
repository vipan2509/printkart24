# PRINTKART24 Environment Configuration

NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5001

# Database Configuration (PostgreSQL supported; fallback SQLite support for local dev without postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/printkart24?schema=public"

# Authentication
JWT_SECRET="printkart24_super_secret_jwt_key_2026_production_ready"
JWT_EXPIRES_IN="7d"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_test_printkart24_demo_key"
RAZORPAY_KEY_SECRET="rzp_test_printkart24_demo_secret"

# Cloudinary / Image Storage (Optional - falls back to local /uploads if not set)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Notifications (Email & WhatsApp)
RESEND_API_KEY=""
WHATSAPP_API_URL="https://graph.facebook.com/v19.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
