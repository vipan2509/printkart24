# ==========================================
# PRINTKART24 — Git Ignore Rules
# ==========================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
*/dist/
build/
*/build/
out/
.next/
.nuxt/
.vite/
*/.vite/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example

# Local SQLite Database & Storage
*.db
*.db-journal
*.sqlite
*.sqlite3
server/dev.db
server/dev.db-journal

# User Uploads & Media Assets
uploads/
*/uploads/
!uploads/.gitkeep
!*/uploads/.gitkeep

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary & Scratch Files
scratch/
scratch_*
tmp/
temp/
*.tmp

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Test & Coverage Artifacts
coverage/
.nyc_output/
playwright-report/
test-results/
